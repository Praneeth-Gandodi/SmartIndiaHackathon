# Keep the build context small and avoid leaking local secrets into an image.

# Dependencies and build output are produced inside the image.
node_modules
build

# Local secrets. FIRMS_MAP_KEY must never reach an image layer.
.env
.env.*
!.env.example

# Version control and CI noise.
.git
.gitignore
.github

# Local tooling and agent artifacts.
.playwright-mcp
*.log
osm-fetch.log
osm-gazetteer.log
.vscode
.idea

# OS cruft.
.DS_Store
Thumbs.db

# Documentation is not needed to build or serve the app.
*.md
!README.md
demo_changes.md
osm-check

# Unused demo media. These are gitignored leftovers; the loading screen uses
# public/satellite.png and the 3D globe uses public/textures/*, so keep those.
public/ref_frame_*.jpg
public/satellite.jpg
public/textures/earth_night.jpg
src/components/image_to_vedio_vedio_clip*.mp4
src/logo.svg
src/firedata.js

# Dockerfile and docker-compose are not needed inside the image.
Dockerfile
docker-compose.yml
.dockerignore
